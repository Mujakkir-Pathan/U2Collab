# Copy to .env (or run `make setup`). Compose substitutes these into
# docker-compose.yml for the local `make up` flow.

# Image tag to run — any tag on Docker Hub (sha-* from CI, or latest)
CLIENT_TAG=latest
SERVER_TAG=latest

# Host ports (host side of host:container)
CLIENT_HOST_PORT=5173
SERVER_HOST_PORT=5000

# Where the server's env file lives (default local path).
SERVER_ENV_FILE=./server/.env

# Build-time Vite vars for `docker compose build`. The defaults (/api and /)
# are same-origin and work with the nginx proxy in client/nginx.conf; only
# change these if you want the browser to call an absolute URL instead.
VITE_API_URL=/api
VITE_SOCKET_URL=/
