# Copy to .env and fill in real values (README → Environment Variables).
# Loaded automatically by `import 'dotenv/config'` in server/app.js.

# Origin of the CLIENT (what CORS allows + where OAuth redirects land)
CLIENT_URL=http://localhost:5173
PORT=5000
# development => cookies work over plain HTTP (production needs HTTPS)
NODE_ENV=development

MONGO_URI=mongodb+srv://...
JWT_SECRET=

# openssl rand -hex 32  → JWT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
